# Email Configuration
# Copy this file to .env and configure your email service

# ========================================
# OPTION 1: SMTP (Gmail, Office365, etc.)
# ========================================
# Recommended for personal email accounts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ========================================
# OPTION 2: SendGrid (Recommended)
# ========================================
# Get API key from: https://sendgrid.com
# SENDGRID_API_KEY=your_sendgrid_api_key

# ========================================
# OPTION 3: Resend (Best for Vercel)
# ========================================
# Get API key from: https://resend.com
# RESEND_API_KEY=your_resend_api_key

# ========================================
# Instructions:
# ========================================
# 1. Choose ONE email service option above
# 2. Uncomment the relevant variables
# 3. Add these variables to Vercel:
#    - Go to your Vercel project dashboard
#    - Settings > Environment Variables
#    - Add each variable with its value
# 4. Redeploy your site after adding variables

